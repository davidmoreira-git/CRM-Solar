<Worksheet ss:Name="Proposta"><Table><Column ss:AutoFitWidth="0" ss:Width="190"/><Column ss:AutoFitWidth="0" ss:Width="120"/><Column ss:AutoFitWidth="0" ss:Width="90"/><Column ss:AutoFitWidth="0" ss:Width="320"/><Row  ss:Height="28"><Cell ss:StyleID="title" ss:MergeAcross="3"><Data ss:Type="String">Proposta Comercial Fotovoltaica</Data></Cell></Row><Row><Cell ss:StyleID="subtitle" ss:MergeAcross="3"><Data ss:Type="String">Resumo pronto para apresentacao ao cliente final</Data></Cell></Row><Row><Cell ss:StyleID="small" ss:MergeAcross="3"><Data ss:Type="String"></Data></Cell></Row><Row><Cell ss:StyleID="section" ss:MergeAcross="3"><Data ss:Type="String">Identificacao</Data></Cell></Row><Row><Cell ss:StyleID="label"><Data ss:Type="String">Cliente</Data></Cell><Cell ss:StyleID="input" ss:Formula="=Entradas!R5C2" ss:MergeAcross="1"><Data ss:Type="String">Preencher nome do cliente</Data></Cell><Cell ss:Index="4" ss:StyleID="note"><Data ss:Type="String">Campo puxado automaticamente.</Data></Cell></Row><Row><Cell ss:StyleID="label"><Data ss:Type="String">Projeto</Data></Cell><Cell ss:StyleID="input" ss:Formula="=Entradas!R6C2" ss:MergeAcross="1"><Data ss:Type="String">Sistema FV On-grid</Data></Cell><Cell ss:Index="4" ss:StyleID="note"><Data ss:Type="String">Use esta aba como resumo executivo.</Data></Cell></Row><Row><Cell ss:StyleID="label"><Data ss:Type="String">Distribuidora</Data></Cell><Cell ss:StyleID="input" ss:Formula="=Entradas!R7C2" ss:MergeAcross="1"><Data ss:Type="String">Preencher distribuidora</Data></Cell><Cell ss:Index="4" ss:StyleID="note"><Data ss:Type="String">Confirme tarifa e regras locais.</Data></Cell></Row><Row><Cell ss:StyleID="label"><Data ss:Type="String">Data da proposta</Data></Cell><Cell ss:StyleID="input" ss:MergeAcross="1"><Data ss:Type="String">2026-04-14</Data></Cell><Cell ss:Index="4" ss:StyleID="note"><Data ss:Type="String">Atualize quando necessario.</Data></Cell></Row><Row><Cell ss:StyleID="label"><Data ss:Type="String">Validade sugerida</Data></Cell><Cell ss:StyleID="input" ss:MergeAcross="1"><Data ss:Type="String">15 dias</Data></Cell><Cell ss:Index="4" ss:StyleID="note"><Data ss:Type="String">Ajuste conforme politica comercial.</Data></Cell></Row><Row><Cell ss:StyleID="small" ss:MergeAcross="3"><Data ss:Type="String"></Data></Cell></Row><Row><Cell ss:StyleID="section" ss:MergeAcross="3"><Data ss:Type="String">Resumo tecnico</Data></Cell></Row><Row><Cell ss:StyleID="label"><Data ss:Type="String">Potencia instalada</Data></Cell><Cell ss:StyleID="number" ss:Formula="=Entradas!R33C2"><Data ss:Type="Number">8.19</Data></Cell><Cell ss:StyleID="input"><Data ss:Type="String">kWp</Data></Cell><Cell ss:StyleID="note"><Data ss:Type="String">Sistema dimensionado para o consumo informado.</Data></Cell></Row><Row><Cell ss:StyleID="label"><Data ss:Type="String">Numero de modulos</Data></Cell><Cell ss:StyleID="integer" ss:Formula="=Entradas!R32C2"><Data ss:Type="Number">14</Data></Cell><Cell ss:StyleID="input"><Data ss:Type="String">un</Data></Cell><Cell ss:StyleID="note"><Data ss:Type="String">Atualizado automaticamente.</Data></Cell></Row><Row><Cell ss:StyleID="label"><Data ss:Type="String">Potencia do modulo</Data></Cell><Cell ss:StyleID="number" ss:Formula="=Entradas!R31C2"><Data ss:Type="Number">585</Data></Cell><Cell ss:StyleID="input"><Data ss:Type="String">Wp</Data></Cell><Cell ss:StyleID="note"><Data ss:Type="String">Atualizado automaticamente.</Data></Cell></Row><Row><Cell ss:StyleID="summary"><Data ss:Type="String">Geracao media mensal</Data></Cell><Cell ss:StyleID="number" ss:Formula="=Entradas!R36C2"><Data ss:Type="Number">951.1</Data></Cell><Cell ss:StyleID="summary"><Data ss:Type="String">kWh/mes</Data></Cell><Cell ss:StyleID="note"><Data ss:Type="String">Estimativa baseada em HSP e PR.</Data></Cell></Row><Row><Cell ss:StyleID="summary"><Data ss:Type="String">Geracao anual</Data></Cell><Cell ss:StyleID="number" ss:Formula="=Entradas!R37C2"><Data ss:Type="Number">11413.2</Data></Cell><Cell ss:StyleID="summary"><Data ss:Type="String">kWh/ano</Data></Cell><Cell ss:StyleID="note"><Data ss:Type="String">Pode ser usada na narrativa comercial.</Data></Cell></Row><Row><Cell ss:StyleID="summary"><Data ss:Type="String">Cobertura da carga</Data></Cell><Cell ss:StyleID="percent" ss:Formula="=Calculos!R28C2"><Data ss:Type="Number">1</Data></Cell><Cell ss:StyleID="summary"><Data ss:Type="String"></Data></Cell><Cell ss:StyleID="note"><Data ss:Type="String">Percentual do consumo anual atendido.</Data></Cell></Row><Row><Cell ss:StyleID="small" ss:MergeAcross="3"><Data ss:Type="String"></Data></Cell></Row><Row><Cell ss:StyleID="section" ss:MergeAcross="3"><Data ss:Type="String">Resumo economico</Data></Cell></Row><Row><Cell ss:StyleID="summary"><Data ss:Type="String">Investimento total</Data></Cell><Cell ss:StyleID="currency" ss:Formula="=Entradas!R46C2"><Data ss:Type="Number">29755.5</Data></Cell><Cell ss:StyleID="summary"><Data ss:Type="String">R$</Data></Cell><Cell ss:StyleID="note"><Data ss:Type="String">CAPEX da proposta.</Data></Cell></Row><Row><Cell ss:StyleID="label"><Data ss:Type="String">Entrada</Data></Cell><Cell ss:StyleID="currency" ss:Formula="=Entradas!R47C2"><Data ss:Type="Number">6000</Data></Cell><Cell ss:StyleID="input"><Data ss:Type="String">R$</Data></Cell><Cell ss:StyleID="note"><Data ss:Type="String">Atualizado automaticamente.</Data></Cell></Row><Row><Cell ss:StyleID="label"><Data ss:Type="String">Valor financiado</Data></Cell><Cell ss:StyleID="currency" ss:Formula="=Entradas!R48C2"><Data ss:Type="Number">23755.5</Data></Cell><Cell ss:StyleID="input"><Data ss:Type="String">R$</Data></Cell><Cell ss:StyleID="note"><Data ss:Type="String">Atualizado automaticamente.</Data></Cell></Row><Row><Cell ss:StyleID="summary"><Data ss:Type="String">Parcela estimada</Data></Cell><Cell ss:StyleID="currency" ss:Formula="=Entradas!R51C2"><Data ss:Type="Number">603.76</Data></Cell><Cell ss:StyleID="summary"><Data ss:Type="String">R$/mes</Data></Cell><Cell ss:StyleID="note"><Data ss:Type="String">Se nao houver financiamento, zerar juros e prazo.</Data></Cell></Row><Row><Cell ss:StyleID="label"><Data ss:Type="String">Fatura atual</Data></Cell><Cell ss:StyleID="currency" ss:Formula="=Entradas!R27C2"><Data ss:Type="Number">803</Data></Cell><Cell ss:StyleID="input"><Data ss:Type="String">R$/mes</Data></Cell><Cell ss:StyleID="note"><Data ss:Type="String">Base sem sistema solar.</Data></Cell></Row><Row><Cell ss:StyleID="summary"><Data ss:Type="String">Fatura com solar</Data></Cell><Cell ss:StyleID="currency" ss:Formula="=Calculos!R21C2"><Data ss:Type="Number">233.6</Data></Cell><Cell ss:StyleID="summary"><Data ss:Type="String">R$/mes</Data></Cell><Cell ss:StyleID="note"><Data ss:Type="String">Inclui disponibilidade, CIP e Fio B.</Data></Cell></Row><Row><Cell ss:StyleID="summary"><Data ss:Type="String">Economia mensal</Data></Cell><Cell ss:StyleID="currency" ss:Formula="=Calculos!R22C2"><Data ss:Type="Number">569.4</Data></Cell><Cell ss:StyleID="summary"><Data ss:Type="String">R$/mes</Data></Cell><Cell ss:StyleID="note"><Data ss:Type="String">Indicador principal da oferta.</Data></Cell></Row><Row><Cell ss:StyleID="summary"><Data ss:Type="String">Economia anual</Data></Cell><Cell ss:StyleID="currency" ss:Formula="=Calculos!R23C2"><Data ss:Type="Number">6832.8</Data></Cell><Cell ss:StyleID="summary"><Data ss:Type="String">R$/ano</Data></Cell><Cell ss:StyleID="note"><Data ss:Type="String">Sem reajuste futuro.</Data></Cell></Row><Row><Cell ss:StyleID="summary"><Data ss:Type="String">Payback simples</Data></Cell><Cell ss:StyleID="number" ss:Formula="=Calculos!R25C2"><Data ss:Type="Number">4.35</Data></Cell><Cell ss:StyleID="summary"><Data ss:Type="String">anos</Data></Cell><Cell ss:StyleID="note"><Data ss:Type="String">Retorno estimado com base no investimento total.</Data></Cell></Row><Row><Cell ss:StyleID="small" ss:MergeAcross="3"><Data ss:Type="String"></Data></Cell></Row><Row><Cell ss:StyleID="section" ss:MergeAcross="3"><Data ss:Type="String">Enquadramento regulatorio</Data></Cell></Row><Row><Cell ss:StyleID="label"><Data ss:Type="String">Classe de enquadramento</Data></Cell><Cell ss:StyleID="input" ss:Formula="=Entradas!R11C2"><Data ss:Type="String">GD II</Data></Cell><Cell ss:StyleID="input"><Data ss:Type="String"></Data></Cell><Cell ss:StyleID="note"><Data ss:Type="String">Lei 14.300/2022.</Data></Cell></Row><Row><Cell ss:StyleID="label"><Data ss:Type="String">Ano regulatorio</Data></Cell><Cell ss:StyleID="integer" ss:Formula="=Entradas!R12C2"><Data ss:Type="Number">2026</Data></Cell><Cell ss:StyleID="input"><Data ss:Type="String"></Data></Cell><Cell ss:StyleID="note"><Data ss:Type="String">Base usada para o Fio B.</Data></Cell></Row><Row><Cell ss:StyleID="summary"><Data ss:Type="String">Percentual Fio B aplicado</Data></Cell><Cell ss:StyleID="percent" ss:Formula="=Entradas!R15C2"><Data ss:Type="Number">0.6</Data></Cell><Cell ss:StyleID="summary"><Data ss:Type="String"></Data></Cell><Cell ss:StyleID="note"><Data ss:Type="String">Para GD II, em 2026 a planilha aplica 60% sobre o TUSD Fio B na energia compensada.</Data></Cell></Row><Row><Cell ss:StyleID="label"><Data ss:Type="String">Premissa legal</Data></Cell><Cell ss:StyleID="note" ss:MergeAcross="1"><Data ss:Type="String">GD I ate 07/01/2023 mantem 100% de compensacao ate 2045. GD II usa a transicao do art. 27. GD III deve ser validado caso a caso.</Data></Cell><Cell ss:Index="4" ss:StyleID="note"><Data ss:Type="String">Revise sempre a regra da distribuidora.</Data></Cell></Row><Row><Cell ss:StyleID="small" ss:MergeAcross="3"><Data ss:Type="String"></Data></Cell></Row><Row><Cell ss:StyleID="section" ss:MergeAcross="3"><Data ss:Type="String">Condicoes comerciais sugeridas</Data></Cell></Row><Row><Cell ss:StyleID="label"><Data ss:Type="String">Escopo</Data></Cell><Cell ss:StyleID="input" ss:MergeAcross="1"><Data ss:Type="String">Projeto, homologacao, fornecimento de materiais e instalacao completa.</Data></Cell><Cell ss:Index="4" ss:StyleID="note"><Data ss:Type="String">Ajuste conforme sua politica comercial.</Data></Cell></Row><Row><Cell ss:StyleID="label"><Data ss:Type="String">Forma de pagamento</Data></Cell><Cell ss:StyleID="input" ss:MergeAcross="1"><Data ss:Type="String">Entrada + saldo financiado ou a vista.</Data></Cell><Cell ss:Index="4" ss:StyleID="note"><Data ss:Type="String">Pode ser customizado por cliente.</Data></Cell></Row><Row><Cell ss:StyleID="label"><Data ss:Type="String">Observacao final</Data></Cell><Cell ss:StyleID="note" ss:MergeAcross="1"><Data ss:Type="String">Planilha de apoio comercial. Atualize tarifas, HSP, PR e preco/Wp antes do envio definitivo.</Data></Cell><Cell ss:Index="4" ss:StyleID="note"><Data ss:Type="String">Aba Dashboard resume os principais indicadores.</Data></Cell></Row></Table>
<WorksheetOptions xmlns="urn:schemas-microsoft-com:office:excel"><ProtectObjects>False</ProtectObjects><ProtectScenarios>False</ProtectScenarios></WorksheetOptions>
</Worksheet>
<Worksheet ss:Name="Entradas"><Table><Column ss:AutoFitWidth="0" ss:Width="190"/><Column ss:AutoFitWidth="0" ss:Width="120"/><Column ss:AutoFitWidth="0" ss:Width="90"/><Column ss:AutoFitWidth="0" ss:Width="320"/><Row  ss:Height="28"><Cell ss:StyleID="title" ss:MergeAcross="3"><Data ss:Type="String">Planilha de Proposta Comercial Solar</Data></Cell></Row><Row><Cell ss:StyleID="subtitle" ss:MergeAcross="3"><Data ss:Type="String">Lei 14.300/2022 com Fio B, premissas editaveis e painel de apoio comercial</Data></Cell></Row><Row><Cell ss:StyleID="small" ss:MergeAcross="3"><Data ss:Type="String"></Data></Cell></Row><Row><Cell ss:StyleID="section" ss:MergeAcross="3"><Data ss:Type="String">1. Dados do cliente e enquadramento</Data></Cell></Row><Row><Cell ss:StyleID="label"><Data ss:Type="String">Cliente</Data></Cell><Cell ss:StyleID="input"><Data ss:Type="String">Preencher nome do cliente</Data></Cell><Cell ><Data ss:Type="String"></Data></Cell><Cell ss:StyleID="note"><Data ss:Type="String">Campo livre para emissao da proposta.</Data></Cell></Row><Row><Cell ss:StyleID="label"><Data ss:Type="String">Projeto</Data></Cell><Cell ss:StyleID="input"><Data ss:Type="String">Sistema FV On-grid</Data></Cell><Cell ><Data ss:Type="String"></Data></Cell><Cell ss:StyleID="note"><Data ss:Type="String">Ex.: residencial, comercial ou remoto.</Data></Cell></Row><Row><Cell ss:StyleID="label"><Data ss:Type="String">Distribuidora</Data></Cell><Cell ss:StyleID="input"><Data ss:Type="String">Preencher distribuidora</Data></Cell><Cell ><Data ss:Type="String"></Data></Cell><Cell ss:StyleID="note"><Data ss:Type="String">Atualize sempre conforme a concessionaria local.</Data></Cell></Row><Row><Cell ss:StyleID="label"><Data ss:Type="String">Grupo tarifario</Data></Cell><Cell ss:StyleID="input"><Data ss:Type="String">B1 Residencial</Data></Cell><Cell ><Data ss:Type="String"></Data></Cell><Cell ss:StyleID="note"><Data ss:Type="String">Premissa padrao para proposta rapida.</Data></Cell></Row><Row><Cell ss:StyleID="label"><Data ss:Type="String">Modalidade de compensacao</Data></Cell><Cell ss:StyleID="input"><Data ss:Type="String">Autoconsumo local</Data></Cell><Cell ><Data ss:Type="String"></Data></Cell><Cell ss:StyleID="note"><Data ss:Type="String">Serve tambem para autoconsumo remoto e geracao compartilhada.</Data></Cell></Row><Row><Cell ss:StyleID="label"><Data ss:Type="String">Data da solicitacao/acesso</Data></Cell><Cell ss:StyleID="input"><Data ss:Type="String">2026-04-14</Data></Cell><Cell ><Data ss:Type="String"></Data></Cell><Cell ss:StyleID="note"><Data ss:Type="String">Use a data real para enquadramento.</Data></Cell></Row><Row><Cell ss:StyleID="label"><Data ss:Type="String">Enquadramento Lei 14.300</Data></Cell><Cell ss:StyleID="input"><Data ss:Type="String">GD II</Data></Cell><Cell ><Data ss:Type="String"></Data></Cell><Cell ss:StyleID="note"><Data ss:Type="String">GD I ate 07/01/2023. GD II apos 08/01/2023. GD III requer validacao.</Data></Cell></Row><Row><Cell ss:StyleID="label"><Data ss:Type="String">Ano regulatorio</Data></Cell><Cell ss:StyleID="integer"><Data ss:Type="Number">2026</Data></Cell><Cell ><Data ss:Type="String"></Data></Cell><Cell ss:StyleID="note"><Data ss:Type="String">Em 2026, o Fio B do GD II esta em 60%.</Data></Cell></Row><Row><Cell ss:StyleID="label"><Data ss:Type="String">Percentual Fio B automatico</Data></Cell><Cell ss:StyleID="percent" ss:Formula="=IF(R[-2]C=&quot;GD I&quot;,0,IF(R[-2]C=&quot;GD III&quot;,1,IF(R[-1]C&lt;=2022,0,IF(R[-1]C=2023,0.15,IF(R[-1]C=2024,0.3,IF(R[-1]C=2025,0.45,IF(R[-1]C=2026,0.6,IF(R[-1]C=2027,0.75,IF(R[-1]C=2028,0.9,1)))))))))"><Data ss:Type="Number">0.6</Data></Cell><Cell ss:StyleID="percent"><Data ss:Type="String"></Data></Cell><Cell ss:StyleID="note"><Data ss:Type="String">Tabela automatica do art. 27 para GD II.</Data></Cell></Row><Row><Cell ss:StyleID="label"><Data ss:Type="String">Percentual Fio B manual (-1 = automatico)</Data></Cell><Cell ss:StyleID="percent"><Data ss:Type="Number">-1</Data></Cell><Cell ss:StyleID="percent"><Data ss:Type="String"></Data></Cell><Cell ss:StyleID="note"><Data ss:Type="String">Use para excecoes ou validacoes especificas.</Data></Cell></Row><Row><Cell ss:StyleID="summary"><Data ss:Type="String">Percentual Fio B aplicado</Data></Cell><Cell ss:StyleID="percent" ss:Formula="=IF(R[-1]C&gt;=0,R[-1]C,R[-2]C)"><Data ss:Type="Number">0.6</Data></Cell><Cell ss:StyleID="summary"><Data ss:Type="String"></Data></Cell><Cell ss:StyleID="note"><Data ss:Type="String">Valor efetivamente usado nos calculos.</Data></Cell></Row><Row><Cell ss:StyleID="small" ss:MergeAcross="3"><Data ss:Type="String"></Data></Cell></Row><Row><Cell ss:StyleID="section" ss:MergeAcross="3"><Data ss:Type="String">2. Consumo e tarifas</Data></Cell></Row><Row><Cell ss:StyleID="label"><Data ss:Type="String">Consumo medio mensal</Data></Cell><Cell ss:StyleID="number"><Data ss:Type="Number">950</Data></Cell><Cell ss:StyleID="input"><Data ss:Type="String">kWh/mes</Data></Cell><Cell ss:StyleID="note"><Data ss:Type="String">Use a media de 12 meses.</Data></Cell></Row><Row><Cell ss:StyleID="label"><Data ss:Type="String">Consumo anual</Data></Cell><Cell ss:StyleID="number" ss:Formula="=R[-1]C*12"><Data ss:Type="Number">11400</Data></Cell><Cell ss:StyleID="summary"><Data ss:Type="String">kWh/ano</Data></Cell><Cell ss:StyleID="note"><Data ss:Type="String">Calculado automaticamente.</Data></Cell></Row><Row><Cell ss:StyleID="label"><Data ss:Type="String">Tarifa TE</Data></Cell><Cell ss:StyleID="currency"><Data ss:Type="Number">0.34</Data></Cell><Cell ss:StyleID="input"><Data ss:Type="String">R$/kWh</Data></Cell><Cell ss:StyleID="note"><Data ss:Type="String">Energia.</Data></Cell></Row><Row><Cell ss:StyleID="label"><Data ss:Type="String">Tarifa TUSD Fio A</Data></Cell><Cell ss:StyleID="currency"><Data ss:Type="Number">0.08</Data></Cell><Cell ss:StyleID="input"><Data ss:Type="String">R$/kWh</Data></Cell><Cell ss:StyleID="note"><Data ss:Type="String">Uso do sistema.</Data></Cell></Row><Row><Cell ss:StyleID="label"><Data ss:Type="String">Tarifa TUSD Fio B</Data></Cell><Cell ss:StyleID="currency"><Data ss:Type="Number">0.28</Data></Cell><Cell ss:StyleID="input"><Data ss:Type="String">R$/kWh</Data></Cell><Cell ss:StyleID="note"><Data ss:Type="String">Base do calculo do Fio B.</Data></Cell></Row><Row><Cell ss:StyleID="label"><Data ss:Type="String">Encargos e tributos estimados</Data></Cell><Cell ss:StyleID="currency"><Data ss:Type="Number">0.12</Data></Cell><Cell ss:StyleID="input"><Data ss:Type="String">R$/kWh</Data></Cell><Cell ss:StyleID="note"><Data ss:Type="String">Ajuste conforme a conta local.</Data></Cell></Row><Row><Cell ss:StyleID="summary"><Data ss:Type="String">Tarifa cheia sem CIP</Data></Cell><Cell ss:StyleID="currency" ss:Formula="=SUM(R[-4]C:R[-1]C)"><Data ss:Type="Number">0.82</Data></Cell><Cell ss:StyleID="summary"><Data ss:Type="String">R$/kWh</Data></Cell><Cell ss:StyleID="note"><Data ss:Type="String">Base da fatura sem solar.</Data></Cell></Row><Row><Cell ss:StyleID="label"><Data ss:Type="String">Custo de disponibilidade mensal</Data></Cell><Cell ss:StyleID="currency"><Data ss:Type="Number">50</Data></Cell><Cell ss:StyleID="input"><Data ss:Type="String">R$/mes</Data></Cell><Cell ss:StyleID="note"><Data ss:Type="String">Mantenha conforme a UC.</Data></Cell></Row><Row><Cell ss:StyleID="label"><Data ss:Type="String">CIP / outros mensais</Data></Cell><Cell ss:StyleID="currency"><Data ss:Type="Number">24</Data></Cell><Cell ss:StyleID="input"><Data ss:Type="String">R$/mes</Data></Cell><Cell ss:StyleID="note"><Data ss:Type="String">Item mantido na conta final.</Data></Cell></Row><Row><Cell ss:StyleID="summary"><Data ss:Type="String">Fatura media atual mensal</Data></Cell><Cell ss:StyleID="currency" ss:Formula="=MAX(R[-9]C*R[-3]C,R[-2]C)+R[-1]C"><Data ss:Type="Number">803</Data></Cell><Cell ss:StyleID="summary"><Data ss:Type="String">R$/mes</Data></Cell><Cell ss:StyleID="note"><Data ss:Type="String">Situacao base sem solar.</Data></Cell></Row><Row><Cell ss:StyleID="summary"><Data ss:Type="String">Fatura media atual anual</Data></Cell><Cell ss:StyleID="currency" ss:Formula="=R[-1]C*12"><Data ss:Type="Number">9636</Data></Cell><Cell ss:StyleID="summary"><Data ss:Type="String">R$/ano</Data></Cell><Cell ss:StyleID="note"><Data ss:Type="String">Base da analise economica.</Data></Cell></Row><Row><Cell ss:StyleID="small" ss:MergeAcross="3"><Data ss:Type="String"></Data></Cell></Row><Row><Cell ss:StyleID="section" ss:MergeAcross="3"><Data ss:Type="String">3. Sistema fotovoltaico</Data></Cell></Row><Row><Cell ss:StyleID="label"><Data ss:Type="String">Potencia do modulo</Data></Cell><Cell ss:StyleID="number"><Data ss:Type="Number">585</Data></Cell><Cell ss:StyleID="input"><Data ss:Type="String">Wp</Data></Cell><Cell ss:StyleID="note"><Data ss:Type="String">Atualize conforme o kit.</Data></Cell></Row><Row><Cell ss:StyleID="label"><Data ss:Type="String">Numero de modulos</Data></Cell><Cell ss:StyleID="integer"><Data ss:Type="Number">14</Data></Cell><Cell ss:StyleID="input"><Data ss:Type="String">un</Data></Cell><Cell ss:StyleID="note"><Data ss:Type="String">Ajuste pela proposta.</Data></Cell></Row><Row><Cell ss:StyleID="summary"><Data ss:Type="String">Potencia instalada</Data></Cell><Cell ss:StyleID="number" ss:Formula="=R[-2]C*R[-1]C/1000"><Data ss:Type="Number">8.19</Data></Cell><Cell ss:StyleID="summary"><Data ss:Type="String">kWp</Data></Cell><Cell ss:StyleID="note"><Data ss:Type="String">Potencia DC do sistema.</Data></Cell></Row><Row><Cell ss:StyleID="label"><Data ss:Type="String">HSP media</Data></Cell><Cell ss:StyleID="number"><Data ss:Type="Number">4.9</Data></Cell><Cell ss:StyleID="input"><Data ss:Type="String">h/dia</Data></Cell><Cell ss:StyleID="note"><Data ss:Type="String">Ajuste pela cidade.</Data></Cell></Row><Row><Cell ss:StyleID="label"><Data ss:Type="String">Performance ratio</Data></Cell><Cell ss:StyleID="percent"><Data ss:Type="Number">0.79</Data></Cell><Cell ss:StyleID="input"><Data ss:Type="String">%</Data></Cell><Cell ss:StyleID="note"><Data ss:Type="String">Perdas globais do sistema.</Data></Cell></Row><Row><Cell ss:StyleID="summary"><Data ss:Type="String">Geracao media mensal</Data></Cell><Cell ss:StyleID="number" ss:Formula="=R[-3]C*R[-2]C*30*R[-1]C"><Data ss:Type="Number">951.1</Data></Cell><Cell ss:StyleID="summary"><Data ss:Type="String">kWh/mes</Data></Cell><Cell ss:StyleID="note"><Data ss:Type="String">Formula: potencia x HSP x 30 x PR.</Data></Cell></Row><Row><Cell ss:StyleID="summary"><Data ss:Type="String">Geracao anual</Data></Cell><Cell ss:StyleID="number" ss:Formula="=R[-1]C*12"><Data ss:Type="Number">11413.2</Data></Cell><Cell ss:StyleID="summary"><Data ss:Type="String">kWh/ano</Data></Cell><Cell ss:StyleID="note"><Data ss:Type="String">Base do fluxo de caixa.</Data></Cell></Row><Row><Cell ss:StyleID="summary"><Data ss:Type="String">Relacao geracao x consumo</Data></Cell><Cell ss:StyleID="percent" ss:Formula="=IF(R[-19]C=0,0,R[-1]C/R[-19]C)"><Data ss:Type="Number">1.0012</Data></Cell><Cell ss:StyleID="summary"><Data ss:Type="String"></Data></Cell><Cell ss:StyleID="note"><Data ss:Type="String">Acima de 100% gera credito.</Data></Cell></Row><Row><Cell ss:StyleID="label"><Data ss:Type="String">Degradacao anual dos modulos</Data></Cell><Cell ss:StyleID="percent"><Data ss:Type="Number">0.005</Data></Cell><Cell ss:StyleID="input"><Data ss:Type="String">%</Data></Cell><Cell ss:StyleID="note"><Data ss:Type="String">Premissa do fluxo 25 anos.</Data></Cell></Row><Row><Cell ss:StyleID="label"><Data ss:Type="String">Reajuste tarifario anual</Data></Cell><Cell ss:StyleID="percent"><Data ss:Type="Number">0.06</Data></Cell><Cell ss:StyleID="input"><Data ss:Type="String">%</Data></Cell><Cell ss:StyleID="note"><Data ss:Type="String">Premissa comercial ajustavel.</Data></Cell></Row><Row><Cell ss:StyleID="small" ss:MergeAcross="3"><Data ss:Type="String"></Data></Cell></Row><Row><Cell ss:StyleID="section" ss:MergeAcross="3"><Data ss:Type="String">4. Investimento e financiamento</Data></Cell></Row><Row><Cell ss:StyleID="label"><Data ss:Type="String">Preco por Wp</Data></Cell><Cell ss:StyleID="currency"><Data ss:Type="Number">3.45</Data></Cell><Cell ss:StyleID="input"><Data ss:Type="String">R$/Wp</Data></Cell><Cell ss:StyleID="note"><Data ss:Type="String">Premissa rapida para orcamento.</Data></Cell></Row><Row><Cell ss:StyleID="summary"><Data ss:Type="String">Equipamentos + instalacao</Data></Cell><Cell ss:StyleID="currency" ss:Formula="=R[-11]C*1000*R[-1]C"><Data ss:Type="Number">28255.5</Data></Cell><Cell ss:StyleID="summary"><Data ss:Type="String">R$</Data></Cell><Cell ss:StyleID="note"><Data ss:Type="String">Base proporcional a potencia.</Data></Cell></Row><Row><Cell ss:StyleID="label"><Data ss:Type="String">Extras / adequacoes</Data></Cell><Cell ss:StyleID="currency"><Data ss:Type="Number">1500</Data></Cell><Cell ss:StyleID="input"><Data ss:Type="String">R$</Data></Cell><Cell ss:StyleID="note"><Data ss:Type="String">Estrutura, padrao, SPDA ou frete.</Data></Cell></Row><Row><Cell ss:StyleID="summary"><Data ss:Type="String">Investimento total</Data></Cell><Cell ss:StyleID="currency" ss:Formula="=R[-2]C+R[-1]C"><Data ss:Type="Number">29755.5</Data></Cell><Cell ss:StyleID="summary"><Data ss:Type="String">R$</Data></Cell><Cell ss:StyleID="note"><Data ss:Type="String">CAPEX estimado da proposta.</Data></Cell></Row><Row><Cell ss:StyleID="label"><Data ss:Type="String">Entrada</Data></Cell><Cell ss:StyleID="currency"><Data ss:Type="Number">6000</Data></Cell><Cell ss:StyleID="input"><Data ss:Type="String">R$</Data></Cell><Cell ss:StyleID="note"><Data ss:Type="String">Se venda a vista, iguale ao investimento total.</Data></Cell></Row><Row><Cell ss:StyleID="summary"><Data ss:Type="String">Valor financiado</Data></Cell><Cell ss:StyleID="currency" ss:Formula="=MAX(R[-2]C-R[-1]C,0)"><Data ss:Type="Number">23755.5</Data></Cell><Cell ss:StyleID="summary"><Data ss:Type="String">R$</Data></Cell><Cell ss:StyleID="note"><Data ss:Type="String">Usado no calculo da parcela.</Data></Cell></Row><Row><Cell ss:StyleID="label"><Data ss:Type="String">Juros do financiamento</Data></Cell><Cell ss:StyleID="percent"><Data ss:Type="Number">0.015</Data></Cell><Cell ss:StyleID="input"><Data ss:Type="String">a.m.</Data></Cell><Cell ss:StyleID="note"><Data ss:Type="String">Ajuste conforme banco ou fintech.</Data></Cell></Row><Row><Cell ss:StyleID="label"><Data ss:Type="String">Prazo do financiamento</Data></Cell><Cell ss:StyleID="integer"><Data ss:Type="Number">60</Data></Cell><Cell ss:StyleID="input"><Data ss:Type="String">meses</Data></Cell><Cell ss:StyleID="note"><Data ss:Type="String">Fluxo considera a parcela nesse periodo.</Data></Cell></Row><Row><Cell ss:StyleID="summary"><Data ss:Type="String">Parcela estimada</Data></Cell><Cell ss:StyleID="currency" ss:Formula="=IF(R[-3]C=0,0,IF(R[-2]C=0,R[-3]C/R[-1]C,R[-3]C*(R[-2]C*(1+R[-2]C)^R[-1]C)/((1+R[-2]C)^R[-1]C-1)))"><Data ss:Type="Number">603.76</Data></Cell><Cell ss:StyleID="summary"><Data ss:Type="String">R$/mes</Data></Cell><Cell ss:StyleID="note"><Data ss:Type="String">Formula financeira padrao.</Data></Cell></Row><Row><Cell ss:StyleID="label"><Data ss:Type="String">Prazo de analise economica</Data></Cell><Cell ss:StyleID="integer"><Data ss:Type="Number">25</Data></Cell><Cell ss:StyleID="input"><Data ss:Type="String">anos</Data></Cell><Cell ss:StyleID="note"><Data ss:Type="String">Aba Fluxo25 acompanha a vida util comercial.</Data></Cell></Row><Row><Cell ss:StyleID="label"><Data ss:Type="String">Observacoes</Data></Cell><Cell ss:StyleID="input" ss:MergeAcross="1"><Data ss:Type="String">Atualize tarifas, CIP, HSP e preco/Wp para cada oportunidade.</Data></Cell><Cell ss:Index="4" ss:StyleID="note"><Data ss:Type="String">Use a aba Proposta para imprimir ou apresentar.</Data></Cell></Row></Table>
