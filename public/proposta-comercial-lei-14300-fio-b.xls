<Worksheet ss:Name="Calculos"><Table><Column ss:AutoFitWidth="0" ss:Width="190"/><Column ss:AutoFitWidth="0" ss:Width="120"/><Column ss:AutoFitWidth="0" ss:Width="90"/><Column ss:AutoFitWidth="0" ss:Width="320"/><Row  ss:Height="28"><Cell ss:StyleID="title" ss:MergeAcross="3"><Data ss:Type="String">Calculo tecnico e economico</Data></Cell></Row><Row><Cell ss:StyleID="subtitle" ss:MergeAcross="3"><Data ss:Type="String">Aba de apoio interno para simulacao comercial e revisao rapida</Data></Cell></Row><Row><Cell ss:StyleID="small" ss:MergeAcross="3"><Data ss:Type="String"></Data></Cell></Row><Row><Cell ss:StyleID="section" ss:MergeAcross="3"><Data ss:Type="String">1. Energia e compensacao</Data></Cell></Row><Row><Cell ss:StyleID="label"><Data ss:Type="String">Consumo medio mensal</Data></Cell><Cell ss:StyleID="number" ss:Formula="=Entradas!R18C2"><Data ss:Type="Number">950</Data></Cell><Cell ss:StyleID="input"><Data ss:Type="String">kWh/mes</Data></Cell><Cell ss:StyleID="note"><Data ss:Type="String">Referencia da aba Entradas.</Data></Cell></Row><Row><Cell ss:StyleID="label"><Data ss:Type="String">Geracao media mensal</Data></Cell><Cell ss:StyleID="number" ss:Formula="=Entradas!R36C2"><Data ss:Type="Number">951.1</Data></Cell><Cell ss:StyleID="input"><Data ss:Type="String">kWh/mes</Data></Cell><Cell ss:StyleID="note"><Data ss:Type="String">Geracao estimada do sistema.</Data></Cell></Row><Row><Cell ss:StyleID="summary"><Data ss:Type="String">Energia compensada</Data></Cell><Cell ss:StyleID="number" ss:Formula="=MIN(R[-2]C,R[-1]C)"><Data ss:Type="Number">950</Data></Cell><Cell ss:StyleID="summary"><Data ss:Type="String">kWh/mes</Data></Cell><Cell ss:StyleID="note"><Data ss:Type="String">Parcela da geracao que reduz consumo faturavel.</Data></Cell></Row><Row><Cell ss:StyleID="summary"><Data ss:Type="String">Energia importada liquida</Data></Cell><Cell ss:StyleID="number" ss:Formula="=MAX(R[-3]C-R[-2]C,0)"><Data ss:Type="Number">0</Data></Cell><Cell ss:StyleID="summary"><Data ss:Type="String">kWh/mes</Data></Cell><Cell ss:StyleID="note"><Data ss:Type="String">Consumo ainda faturado integralmente.</Data></Cell></Row><Row><Cell ss:StyleID="summary"><Data ss:Type="String">Excedente / credito mensal</Data></Cell><Cell ss:StyleID="number" ss:Formula="=MAX(R[-3]C-R[-4]C,0)"><Data ss:Type="Number">1.1</Data></Cell><Cell ss:StyleID="summary"><Data ss:Type="String">kWh/mes</Data></Cell><Cell ss:StyleID="note"><Data ss:Type="String">Se positivo, vira credito no SCEE.</Data></Cell></Row><Row><Cell ss:StyleID="summary"><Data ss:Type="String">Percentual Fio B aplicado</Data></Cell><Cell ss:StyleID="percent" ss:Formula="=Entradas!R15C2"><Data ss:Type="Number">0.6</Data></Cell><Cell ss:StyleID="summary"><Data ss:Type="String"></Data></Cell><Cell ss:StyleID="note"><Data ss:Type="String">Aplicado sobre a energia compensada.</Data></Cell></Row><Row><Cell ss:StyleID="label"><Data ss:Type="String">Tarifa cheia sem CIP</Data></Cell><Cell ss:StyleID="currency" ss:Formula="=Entradas!R24C2"><Data ss:Type="Number">0.82</Data></Cell><Cell ss:StyleID="input"><Data ss:Type="String">R$/kWh</Data></Cell><Cell ss:StyleID="note"><Data ss:Type="String">Mesma base da fatura sem solar.</Data></Cell></Row><Row><Cell ss:StyleID="label"><Data ss:Type="String">Tarifa TUSD Fio B</Data></Cell><Cell ss:StyleID="currency" ss:Formula="=Entradas!R22C2"><Data ss:Type="Number">0.28</Data></Cell><Cell ss:StyleID="input"><Data ss:Type="String">R$/kWh</Data></Cell><Cell ss:StyleID="note"><Data ss:Type="String">Tarifa base do Fio B.</Data></Cell></Row><Row><Cell ss:StyleID="label"><Data ss:Type="String">Custo de disponibilidade</Data></Cell><Cell ss:StyleID="currency" ss:Formula="=Entradas!R25C2"><Data ss:Type="Number">50</Data></Cell><Cell ss:StyleID="input"><Data ss:Type="String">R$/mes</Data></Cell><Cell ss:StyleID="note"><Data ss:Type="String">Permanece na unidade consumidora.</Data></Cell></Row><Row><Cell ss:StyleID="label"><Data ss:Type="String">CIP / outros</Data></Cell><Cell ss:StyleID="currency" ss:Formula="=Entradas!R26C2"><Data ss:Type="Number">24</Data></Cell><Cell ss:StyleID="input"><Data ss:Type="String">R$/mes</Data></Cell><Cell ss:StyleID="note"><Data ss:Type="String">Nao entra na compensacao.</Data></Cell></Row><Row><Cell ss:StyleID="small" ss:MergeAcross="3"><Data ss:Type="String"></Data></Cell></Row><Row><Cell ss:StyleID="section" ss:MergeAcross="3"><Data ss:Type="String">2. Resultado mensal</Data></Cell></Row><Row><Cell ss:StyleID="summary"><Data ss:Type="String">Fatura sem solar</Data></Cell><Cell ss:StyleID="currency" ss:Formula="=Entradas!R27C2"><Data ss:Type="Number">803</Data></Cell><Cell ss:StyleID="summary"><Data ss:Type="String">R$/mes</Data></Cell><Cell ss:StyleID="note"><Data ss:Type="String">Situacao base.</Data></Cell></Row><Row><Cell ss:StyleID="label"><Data ss:Type="String">Custo da energia importada</Data></Cell><Cell ss:StyleID="currency" ss:Formula="=R[-10]C*R[-7]C"><Data ss:Type="Number">0</Data></Cell><Cell ss:StyleID="input"><Data ss:Type="String">R$/mes</Data></Cell><Cell ss:StyleID="note"><Data ss:Type="String">Energia ainda comprada integralmente.</Data></Cell></Row><Row><Cell ss:StyleID="label"><Data ss:Type="String">Cobranca de Fio B</Data></Cell><Cell ss:StyleID="currency" ss:Formula="=R[-12]C*R[-7]C*R[-9]C"><Data ss:Type="Number">159.6</Data></Cell><Cell ss:StyleID="input"><Data ss:Type="String">R$/mes</Data></Cell><Cell ss:StyleID="note"><Data ss:Type="String">Energia compensada x TUSD Fio B x percentual.</Data></Cell></Row><Row><Cell ss:StyleID="summary"><Data ss:Type="String">Fatura com solar (energia)</Data></Cell><Cell ss:StyleID="currency" ss:Formula="=MAX(R[-7]C,R[-2]C+R[-1]C)"><Data ss:Type="Number">209.6</Data></Cell><Cell ss:StyleID="summary"><Data ss:Type="String">R$/mes</Data></Cell><Cell ss:StyleID="note"><Data ss:Type="String">Maior entre disponibilidade e energia+Fio B.</Data></Cell></Row><Row><Cell ss:StyleID="summary"><Data ss:Type="String">Fatura com solar total</Data></Cell><Cell ss:StyleID="currency" ss:Formula="=R[-1]C+R[-7]C"><Data ss:Type="Number">233.6</Data></Cell><Cell ss:StyleID="summary"><Data ss:Type="String">R$/mes</Data></Cell><Cell ss:StyleID="note"><Data ss:Type="String">Inclui CIP/outros.</Data></Cell></Row><Row><Cell ss:StyleID="summary"><Data ss:Type="String">Economia mensal</Data></Cell><Cell ss:StyleID="currency" ss:Formula="=R[-5]C-R[-1]C"><Data ss:Type="Number">569.4</Data></Cell><Cell ss:StyleID="summary"><Data ss:Type="String">R$/mes</Data></Cell><Cell ss:StyleID="note"><Data ss:Type="String">Indicador principal da proposta.</Data></Cell></Row><Row><Cell ss:StyleID="summary"><Data ss:Type="String">Economia anual</Data></Cell><Cell ss:StyleID="currency" ss:Formula="=R[-1]C*12"><Data ss:Type="Number">6832.8</Data></Cell><Cell ss:StyleID="summary"><Data ss:Type="String">R$/ano</Data></Cell><Cell ss:StyleID="note"><Data ss:Type="String">Sem reajuste futuro.</Data></Cell></Row><Row><Cell ss:StyleID="summary"><Data ss:Type="String">Reducao percentual da conta</Data></Cell><Cell ss:StyleID="percent" ss:Formula="=IF(R[-7]C=0,0,R[-2]C/R[-7]C)"><Data ss:Type="Number">0.709</Data></Cell><Cell ss:StyleID="summary"><Data ss:Type="String"></Data></Cell><Cell ss:StyleID="note"><Data ss:Type="String">Economia mensal / fatura sem solar.</Data></Cell></Row><Row><Cell ss:StyleID="summary"><Data ss:Type="String">Payback simples</Data></Cell><Cell ss:StyleID="number" ss:Formula="=IF(R[-2]C=0,0,Entradas!R46C2/R[-2]C)"><Data ss:Type="Number">4.35</Data></Cell><Cell ss:StyleID="summary"><Data ss:Type="String">anos</Data></Cell><Cell ss:StyleID="note"><Data ss:Type="String">Baseado no investimento total.</Data></Cell></Row><Row><Cell ss:StyleID="summary"><Data ss:Type="String">Payback de caixa</Data></Cell><Cell ss:StyleID="number" ss:Formula="=IF(R[-3]C=0,0,Entradas!R47C2/R[-3]C)"><Data ss:Type="Number">0.88</Data></Cell><Cell ss:StyleID="summary"><Data ss:Type="String">anos</Data></Cell><Cell ss:StyleID="note"><Data ss:Type="String">Baseado apenas na entrada.</Data></Cell></Row><Row><Cell ss:StyleID="summary"><Data ss:Type="String">Producao especifica</Data></Cell><Cell ss:StyleID="number" ss:Formula="=IF(Entradas!R33C2=0,0,R[-21]C/Entradas!R33C2)"><Data ss:Type="Number">116.13</Data></Cell><Cell ss:StyleID="summary"><Data ss:Type="String">kWh/kWp.mes</Data></Cell><Cell ss:StyleID="note"><Data ss:Type="String">Valida a simulacao.</Data></Cell></Row><Row><Cell ss:StyleID="summary"><Data ss:Type="String">Cobertura do consumo anual</Data></Cell><Cell ss:StyleID="percent" ss:Formula="=IF(Entradas!R19C2=0,0,MIN(Entradas!R37C2,Entradas!R19C2)/Entradas!R19C2)"><Data ss:Type="Number">1</Data></Cell><Cell ss:StyleID="summary"><Data ss:Type="String"></Data></Cell><Cell ss:StyleID="note"><Data ss:Type="String">Capacidade de atendimento da carga.</Data></Cell></Row><Row><Cell ss:StyleID="summary"><Data ss:Type="String">Fluxo anual apos parcela</Data></Cell><Cell ss:StyleID="currency" ss:Formula="=R[-6]C-(Entradas!R51C2*12)"><Data ss:Type="Number">-412.32</Data></Cell><Cell ss:StyleID="summary"><Data ss:Type="String">R$/ano</Data></Cell><Cell ss:StyleID="note"><Data ss:Type="String">Ajuda a vender financiado com clareza.</Data></Cell></Row></Table>
